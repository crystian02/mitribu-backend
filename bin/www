'use strict';
const app = require('../app');
const http = require('http');
const { Server } = require('socket.io');
const fs = require('fs');
const path = require('path');

const port = process.env.PORT || '3000';
app.set('port', port);

const server = http.createServer(app);
const io = new Server(server, { cors: { origin: '*' } });
app.set('socketio', io);

// Carga Dinámica de Controladores
const controllersPath = path.join(__dirname, '..', 'controllers');
fs.readdirSync(controllersPath).forEach((file) => {
    if (file.endsWith('.js')) {
        const ctrl = require(path.join(controllersPath, file));
        if (typeof ctrl.controller === 'function') {
            ctrl.controller(app, io);
            console.log(`[OK] Controlador: ${file}`);
        }
    }
});

server.listen(port, () => console.log(`🚀 MiTribu API en puerto ${port}`));